ngx_addon_name=ngx_http_cert_expiry_module

# The module reads certificates, so it needs an nginx that has OpenSSL and
# the ssl module.  Saying so here is friendlier than a compile error about
# ngx_http_ssl_module half an hour later.
if [ "$HTTP_SSL" != YES ]; then
    echo
    echo "$0: error: ngx_http_cert_expiry_module requires --with-http_ssl_module"
    echo
    exit 1
fi

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=$ngx_addon_name
    ngx_module_srcs="$ngx_addon_dir/src/ngx_http_cert_expiry_module.c"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_cert_expiry_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS \
        $ngx_addon_dir/src/ngx_http_cert_expiry_module.c"
fi
